# ---- Local PostgreSQL (already installed on your laptop, NOT in Docker) ----
# host.docker.internal lets containers reach a Postgres running on your host machine.
PG_HOST=host.docker.internal
PG_PORT=5432
PG_DB=hospital_dw
PG_USER=postgres
PG_PASSWORD=your_local_postgres_password

# ---- Airflow's OWN metadata database (this one DOES run in Docker) ----
AIRFLOW_PG_USER=airflow
AIRFLOW_PG_PASSWORD=airflow
AIRFLOW_PG_DB=airflow

AIRFLOW_UID=50000
